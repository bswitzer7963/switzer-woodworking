//https://devsheets.io/sheets/prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum projType {
  Bowl
  Bat
  CuttingBoard
  Sign
  Emblem
  Patch
}

enum accType {
  Emmet
  Customer
  Admin
}

enum sizeType {
  Small
  Medium
  Large
  Custom
}

enum projStatus {
  Pending
  Accepted
  StartedBuilding
  ReadyToDeliver
}

model User {
  userID String @id @default(cuid())

  fName    String
  lName    String
  email    String  @unique
  pwHash   String
  phNumber String?

  orderHistory Req[]

  accType accType
}

model Req {
  reqID String @id @default(cuid())

  creatorID String
  creator   User   @relation(fields: [creatorID], references: [userID])

  projectType projType
  description String
  size        sizeType?
  status      projStatus @default(Pending)

  customImage String? //Would just store url for submitted image

  whenSubmitted DateTime @default(now())
}
