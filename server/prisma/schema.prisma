//https://devsheets.io/sheets/prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum projType {
  Bowl
  Bat
  CuttingBoardRect
  CuttingBoardSquare
  Sign
  Emblem
  Custom
}

enum accType {
  Emmet
  Customer
  Admin
}

enum sizeType {
  Small
  Medium
  Large
  Custom
}

enum projStatus {
  userSaved
  Pending
  Accepted
  StartedBuilding
  ReadyToDeliver
}

model User {
  userID String @id @default(cuid())

  fName String
  lName String
  email String @unique
  pwHash String
  phNumber String?

  savedProjects Project[]
  
  accType accType
}

model ExistingForSale {
  existingID String @id @default(cuid())

  projTitle String
  projectType projType
  description String
  size sizeType?
  price String

  image String[] //Would just store urls for submitted images

  whenMade DateTime @default(now())
}

model Project {
  projID String @id @default(cuid())

  creatorID String
  creator User @relation(fields: [creatorID], references: [userID])

  projTitle String
  projType projType
  description String
  size sizeType?

  status projStatus @default(userSaved)

  image String[]
  imagePos Json[] //Stores image location

  snapshot String? //Would be simply a snapshot of the current build for little thumbnail

  whenStarted DateTime @default(now())
}